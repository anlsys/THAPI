#include "lttng/tracepoint_gen.h"
#include <cuda.h>

TRACEPOINT_EVENT(
  lttng_ust_cuda_properties,
  device,
  TP_ARGS(
    int, ordinal,
    CUdevice, device,
    char *, name,
    CUuuid *, uuid
  ),
  TP_FIELDS(
    ctf_integer(int, ordinal, ordinal)
    ctf_integer_hex(int, device, device)
    ctf_string(name, name)
    ctf_sequence_text(uint8_t, uuid, uuid, size_t, sizeof(CUuuid))
  )
)

