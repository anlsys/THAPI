#include "lttng/tracepoint_gen.h"
#include "ze.h.include"
TRACEPOINT_EVENT(
  lttng_ust_zel_structs,
  zel_tracer_desc_t,
  TP_ARGS(
    zel_tracer_desc_t *, p
  ),
  TP_FIELDS(
    ctf_integer_hex(uintptr_t, p, (uintptr_t)(p))
    ctf_sequence_text(uint8_t, p_val, p, size_t, (p ? sizeof(zel_tracer_desc_t) : 0))
  )
)

