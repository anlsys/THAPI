TRACEPOINT_EVENT(
  lttng_ust_zex,
  zexMemGetIpcHandles_entry,
  TP_ARGS(
    ze_context_handle_t, hContext,
    const void *, ptr,
    uint32_t *, numIpcHandles,
    ze_ipc_mem_handle_t *, pIpcHandles
  ),
  TP_FIELDS(
    ctf_integer_hex(uintptr_t, hContext, (uintptr_t)(hContext))
    ctf_integer_hex(uintptr_t, ptr, (uintptr_t)(ptr))
    ctf_integer_hex(uintptr_t, numIpcHandles, (uintptr_t)(numIpcHandles))
    ctf_integer_hex(uintptr_t, pIpcHandles, (uintptr_t)(pIpcHandles))
    ctf_integer(uint32_t, numIpcHandles_val, (numIpcHandles ? *numIpcHandles : 0))
  )
)

TRACEPOINT_EVENT(
  lttng_ust_zex,
  zexMemGetIpcHandles_exit,
  TP_ARGS(
    ze_context_handle_t, hContext,
    const void *, ptr,
    uint32_t *, numIpcHandles,
    ze_ipc_mem_handle_t *, pIpcHandles,
    ze_result_t, zeResult
  ),
  TP_FIELDS(
    ctf_integer(int32_t, zeResult, zeResult)
    ctf_integer(uint32_t, numIpcHandles_val, (numIpcHandles ? *numIpcHandles : 0))
    ctf_sequence_text(uint8_t, pIpcHandles_vals, pIpcHandles, size_t, ((numIpcHandles && pIpcHandles ? *numIpcHandles : 0)) * sizeof(ze_ipc_mem_handle_t))
  )
)

TRACEPOINT_EVENT(
  lttng_ust_zex,
  zexMemOpenIpcHandles_entry,
  TP_ARGS(
    ze_context_handle_t, hContext,
    ze_device_handle_t, hDevice,
    uint32_t, numIpcHandles,
    ze_ipc_mem_handle_t *, pIpcHandles,
    ze_ipc_memory_flags_t, flags,
    void **, pptr
  ),
  TP_FIELDS(
    ctf_integer_hex(uintptr_t, hContext, (uintptr_t)(hContext))
    ctf_integer_hex(uintptr_t, hDevice, (uintptr_t)(hDevice))
    ctf_integer(uint32_t, numIpcHandles, numIpcHandles)
    ctf_integer_hex(uintptr_t, pIpcHandles, (uintptr_t)(pIpcHandles))
    ctf_integer(ze_ipc_memory_flags_t, flags, flags)
    ctf_integer_hex(uintptr_t, pptr, (uintptr_t)(pptr))
    ctf_sequence_text(uint8_t, pIpcHandles_vals, pIpcHandles, size_t, ((pIpcHandles ? numIpcHandles : 0)) * sizeof(ze_ipc_mem_handle_t))
  )
)

TRACEPOINT_EVENT(
  lttng_ust_zex,
  zexMemOpenIpcHandles_exit,
  TP_ARGS(
    ze_context_handle_t, hContext,
    ze_device_handle_t, hDevice,
    uint32_t, numIpcHandles,
    ze_ipc_mem_handle_t *, pIpcHandles,
    ze_ipc_memory_flags_t, flags,
    void **, pptr,
    ze_result_t, zeResult
  ),
  TP_FIELDS(
    ctf_integer(int32_t, zeResult, zeResult)
    ctf_integer_hex(uintptr_t, pptr_val, (uintptr_t)((pptr ? *pptr : 0)))
  )
)

