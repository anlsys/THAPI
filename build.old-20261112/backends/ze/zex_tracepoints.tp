TRACEPOINT_EVENT(
  lttng_ust_zex,
  zexKernelGetBaseAddress_entry,
  TP_ARGS(
    ze_kernel_handle_t, hKernel,
    uint64_t *, baseAddress
  ),
  TP_FIELDS(
    ctf_integer_hex(uintptr_t, hKernel, (uintptr_t)(hKernel))
    ctf_integer_hex(uintptr_t, baseAddress, (uintptr_t)(baseAddress))
  )
)

TRACEPOINT_EVENT(
  lttng_ust_zex,
  zexKernelGetBaseAddress_exit,
  TP_ARGS(
    ze_kernel_handle_t, hKernel,
    uint64_t *, baseAddress,
    ze_result_t, zeResult
  ),
  TP_FIELDS(
    ctf_integer(int32_t, zeResult, zeResult)
  )
)

