#include "lttng/tracepoint_gen.h"
#include "ze.h.include"
TRACEPOINT_EVENT(
  lttng_ust_ze,
  zeInit_entry,
  TP_ARGS(
    ze_init_flags_t, flags
  ),
  TP_FIELDS(
    ctf_integer(ze_init_flags_t, flags, flags)
  )
)

TRACEPOINT_EVENT(
  lttng_ust_ze,
  zeInit_exit,
  TP_ARGS(
    ze_init_flags_t, flags,
    ze_result_t, zeResult
  ),
  TP_FIELDS(
    ctf_integer(int32_t, zeResult, zeResult)
  )
)

TRACEPOINT_EVENT(
  lttng_ust_ze,
  zeDriverGet_entry,
  TP_ARGS(
    uint32_t *, pCount,
    ze_driver_handle_t *, phDrivers
  ),
  TP_FIELDS(
    ctf_integer_hex(uintptr_t, pCount, (uintptr_t)(pCount))
    ctf_integer_hex(uintptr_t, phDrivers, (uintptr_t)(phDrivers))
    ctf_integer(uint32_t, pCount_val, (pCount ? *pCount : 0))
  )
)

TRACEPOINT_EVENT(
  lttng_ust_ze,
  zeDriverGet_exit,
  TP_ARGS(
    uint32_t *, pCount,
    ze_driver_handle_t *, phDrivers,
    ze_result_t, zeResult
  ),
  TP_FIELDS(
    ctf_integer(int32_t, zeResult, zeResult)
    ctf_integer(uint32_t, pCount_val, (pCount ? *pCount : 0))
    ctf_sequence_hex(uintptr_t, phDrivers_vals, phDrivers, uint32_t, (pCount && phDrivers ? *pCount : 0))
  )
)

TRACEPOINT_EVENT(
  lttng_ust_ze,
  zeInitDrivers_entry,
  TP_ARGS(
    uint32_t *, pCount,
    ze_driver_handle_t *, phDrivers,
    ze_init_driver_type_desc_t *, desc
  ),
  TP_FIELDS(
    ctf_integer_hex(uintptr_t, pCount, (uintptr_t)(pCount))
    ctf_integer_hex(uintptr_t, phDrivers, (uintptr_t)(phDrivers))
    ctf_integer_hex(uintptr_t, desc, (uintptr_t)(desc))
    ctf_sequence_text(uint8_t, desc_val, desc, size_t, (desc ? sizeof(ze_init_driver_type_desc_t) : 0))
    ctf_integer(uint32_t, pCount_val, (pCount ? *pCount : 0))
  )
)

TRACEPOINT_EVENT(
  lttng_ust_ze,
  zeInitDrivers_exit,
  TP_ARGS(
    uint32_t *, pCount,
    ze_driver_handle_t *, phDrivers,
    ze_init_driver_type_desc_t *, desc,
    ze_result_t, zeResult
  ),
  TP_FIELDS(
    ctf_integer(int32_t, zeResult, zeResult)
    ctf_integer(uint32_t, pCount_val, (pCount ? *pCount : 0))
    ctf_sequence_hex(uintptr_t, phDrivers_vals, phDrivers, uint32_t, (pCount && phDrivers ? *pCount : 0))
  )
)

