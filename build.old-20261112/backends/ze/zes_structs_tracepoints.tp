TRACEPOINT_EVENT(
  lttng_ust_zes_structs,
  zes_base_state_t,
  TP_ARGS(
    zes_base_state_t *, p
  ),
  TP_FIELDS(
    ctf_integer_hex(uintptr_t, p, (uintptr_t)(p))
    ctf_sequence_text(uint8_t, p_val, p, size_t, (p ? sizeof(zes_base_state_t) : 0))
  )
)

