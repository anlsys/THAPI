TRACEPOINT_EVENT(
  lttng_ust_zet,
  zetModuleGetDebugInfo_entry,
  TP_ARGS(
    zet_module_handle_t, hModule,
    zet_module_debug_info_format_t, format,
    size_t *, pSize,
    uint8_t *, pDebugInfo
  ),
  TP_FIELDS(
    ctf_integer_hex(uintptr_t, hModule, (uintptr_t)(hModule))
    ctf_integer(int32_t, format, format)
    ctf_integer_hex(uintptr_t, pSize, (uintptr_t)(pSize))
    ctf_integer_hex(uintptr_t, pDebugInfo, (uintptr_t)(pDebugInfo))
    ctf_integer(size_t, pSize_val, (pSize ? *pSize : 0))
  )
)

TRACEPOINT_EVENT(
  lttng_ust_zet,
  zetModuleGetDebugInfo_exit,
  TP_ARGS(
    zet_module_handle_t, hModule,
    zet_module_debug_info_format_t, format,
    size_t *, pSize,
    uint8_t *, pDebugInfo,
    ze_result_t, zeResult
  ),
  TP_FIELDS(
    ctf_integer(int32_t, zeResult, zeResult)
    ctf_integer(size_t, pSize_val, (pSize ? *pSize : 0))
  )
)

