#include "lttng/tracepoint_gen.h"
#include "ze.h.include"
TRACEPOINT_EVENT(
  lttng_ust_zel,
  zelTracerCreate_entry,
  TP_ARGS(
    const zel_tracer_desc_t *, desc,
    zel_tracer_handle_t *, phTracer
  ),
  TP_FIELDS(
    ctf_integer_hex(uintptr_t, desc, (uintptr_t)(desc))
    ctf_integer_hex(uintptr_t, phTracer, (uintptr_t)(phTracer))
    ctf_sequence_text(uint8_t, desc_val, desc, size_t, (desc ? sizeof(zel_tracer_desc_t) : 0))
  )
)

TRACEPOINT_EVENT(
  lttng_ust_zel,
  zelTracerCreate_exit,
  TP_ARGS(
    const zel_tracer_desc_t *, desc,
    zel_tracer_handle_t *, phTracer,
    ze_result_t, zeResult
  ),
  TP_FIELDS(
    ctf_integer(int32_t, zeResult, zeResult)
  )
)

TRACEPOINT_EVENT(
  lttng_ust_zel,
  zelTracerDestroy_entry,
  TP_ARGS(
    zel_tracer_handle_t, hTracer
  ),
  TP_FIELDS(
    ctf_integer_hex(uintptr_t, hTracer, (uintptr_t)(hTracer))
  )
)

TRACEPOINT_EVENT(
